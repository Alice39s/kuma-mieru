  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "build": "turbo run build",
