{
  "name": "kuma-mieru",
  "description": "A 3rd-party Uptime Kuma monitoring dashboard built on Next.js 16, TypeScript and Recharts.",
  "version": "1.7.4",
  "author": "Alice39s",
  "license": "MPL-2.0",
  "homepage": "https://github.com/Alice39s/kuma-mieru",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alice39s/kuma-mieru.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run dev:v2",
    "dev:v1": "bun run generate && bun run lint:fix && next dev --turbopack --port 3881",
    "dev:v2": "bun scripts/dev-v2.ts",
    "dev:v2:server": "tsx watch src/server/index.ts",
    "dev:v2:web": "vite --port 3881",
    "start": "bun run start:v2",
    "start:v1": "bun run generate && bun ./scripts/init-start.ts && bun .next/standalone/server.js",
    "start:v2": "node dist/v2/server/index.js",
    "migrate-v1": "bun run build:v2:server && node dist/v2/server/cli/migrate-v1.js",
    "restore-backup": "bun run build:v2:server && node dist/v2/server/cli/restore-backup.js",
    "start:docker": "bun run generate && node ./server.js",
    "build": "bun run build:v2",
    "build:v1": "bun run generate && next build",
    "build:v2": "bun scripts/build-v2.ts",
    "build:v2:server": "tsc -p tsconfig.server.json",
    "build:v2:web": "vite build",
    "verify:v2:bundle": "bun scripts/verify-v2-bundle.ts",
    "generate:v2:og-fallback": "bun scripts/generate-v2-og-fallback.ts",
    "release:v2:manifest": "bun scripts/generate-v2-release-manifest.ts",
    "release:v2:manifest:strict": "bun scripts/generate-v2-release-manifest.ts --strict",
    "release:v2:policy": "bun scripts/resolve-v2-release.ts",
    "build:analyze": "bun run generate && ANALYZE=true next build",
    "build:cloudflare": "CF_DEPLOYMENT=true bun run generate && opennextjs-cloudflare build",
    "deploy:cloudflare": "CF_DEPLOYMENT=true opennextjs-cloudflare deploy",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix . && oxfmt .",
    "format": "oxfmt .",
    "test": "bun run test:v1 && bun run test:v2",
    "test:v1": "bun test components",
    "test:v2": "bun run test:v2:web && bun run build:v2:server && bun scripts/test-v2.ts",
    "test:v2:web": "bun test src/client/*.test.ts",
    "test:v2:e2e": "bun run build:v2:web && playwright test",
    "typecheck:v2": "tsc -p tsconfig.v2.json && tsc -p tsconfig.server.json --noEmit",
    "generate": "bun scripts/generate-config.ts && bun scripts/generate-image-domains.ts && bun scripts/banner.ts",
    "generate:config": "bun scripts/generate-config.ts",
    "generate:domains": "bun scripts/generate-image-domains.ts",
    "generate:banner": "bun scripts/banner.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.6.23",
    "@expressive-code/plugin-shiki": "^0.44.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@heroui/react": "^2.8.10",
    "@heroui/theme": "2.4.26",
    "@hono/node-server": "^2.0.11",
    "@hookform/resolvers": "^5.4.0",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/bundle-analyzer": "^16.2.10",
    "@opennextjs/cloudflare": "^1.20.1",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/visually-hidden": "3.9.1",
    "@sankyu/react-circle-flags": "^1.6.7",
    "@tailwindcss/postcss": "^4.3.2",
    "better-auth": "1.6.23",
    "better-sqlite3": "^13.0.1",
    "chalk": "5.6.2",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "expressive-code": "^0.44.0",
    "framer-motion": "^12.42.2",
    "hono": "^4.12.31",
    "intl-messageformat": "^11.2.9",
    "json5": "^2.2.3",
    "lucide-react": "^1.23.0",
    "next": "^16.2.10",
    "next-intl": "^4.13.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "react-router": "7.18.1",
    "recharts": "^3.9.2",
    "rehype-expressive-code": "^0.44.0",
    "rehype-external-links": "^3.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.2",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "takumi-js": "2.4.2",
    "tm-themes": "^1.12.2",
    "unified": "^11.0.5",
    "usehooks-ts": "^3.1.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@next/eslint-plugin-next": "16.2.10",
    "@playwright/test": "^1.62.0",
    "@react-types/shared": "3.36.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "@vitejs/plugin-react": "^6.0.4",
    "dotenv": "^17.4.2",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "postcss": "8.5.16",
    "shiki": "^4.3.1",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "vite": "^8.1.5",
    "wrangler": "^4.107.1"
  },
  "trustedDependencies": [
    "@heroui/shared-utils",
    "better-sqlite3",
    "sharp",
    "workerd"
  ]
}
