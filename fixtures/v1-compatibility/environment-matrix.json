        "sources": [
          {
            "baseUrl": "https://status.example.com/root",
            "pageIds": ["main"],
            "timeoutMs": null
          },
          {
            "baseUrl": "https://status.example.com/root",
            "pageIds": ["api"],
            "timeoutMs": null
          }
        ],
        "pages": [
          {
