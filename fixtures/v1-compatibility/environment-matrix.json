            "title": "Fallback title",
            "description": null,
            "icon": "/legacy.svg",
            "editThisPage": false,
            "showStarButton": false
          }
        ],
        "decisionStatuses": {
          "UPTIME_KUMA_BASE_URL": "mapped",
          "PAGE_ID": "mapped",
          "FEATURE_SHOW_STAR_BUTTON": "mapped",
          "FEATURE_TITLE": "mapped",
          "FEATURE_ICON": "mapped"
        },
        "conflicts": [],
